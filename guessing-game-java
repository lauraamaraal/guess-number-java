import java.util.Scanner; // importa para meu programa a ferramenta "scanner" que está na pasta "java.util"
import java.util.Random; // importa para meu programa a ferramenta "random" que está na pasta "java.util"

public class JogoDeAdivinhacao {
    public static void main(String[] args) {

        Scanner entrada = new Scanner(System.in); // vai ler o que o usuário digitar
        Random random = new Random(); // vai gerar números aleatórios

        char jogarNovamente; // lê a resposta do usuário e gaurda um caractere, nesse caso, "s" ou "n"

        do { // início do laço de repetição FAÇA
            System.out.println("JOGO DE ADIVINHAÇÃO"); // mostra título para usuário
            System.out.println();
            System.out.println("Tente adivinhar o número secreto (1 a 100)!");
            System.out.println(); // usado para dar espaço e separar as escritas para manter o layout organizado
            System.out.println("Você terá 7 tentativas, boa sorte!");

            // mostra informação na tela do usuário a quantidade de tentativas e quais números ele poderá escolher

            int palpite = 0; // guarda o palpite do usuário
            int numeroSecreto = random.nextInt(100) + 1; // sorteia um número de 0 a 99, somando um, ou seja, 1 a 100, que será o número secreto da rodada

            System.out.println("Digite seu palpite: "); // usuário digita palpite

            int tentativas = 0; // conta quantas vezes já tentou
            int maxTentativas = 7; // para definir a quantidade máxima de tentativas por rodada
            boolean acertou = false; // mostra se o jogador acertou

            while (tentativas < maxTentativas && !acertou) { // "ENQUANTO ainda tiver tentativas E o jogador NÃO acertou, continua pedindo palpites
                System.out.print("Tentativa " + (tentativas + 1) + ": "); // mostra número de tentativas
                palpite = entrada.nextInt(); // lê o número que o usuário digitou
                tentativas++; // aumenta o contador de tentativas em 1

                if (palpite > numeroSecreto) {
                    System.out.println("O número secreto é MENOR!"); // SE o palpite for maior do que o número secreto, então a mensagem vai orientar ao usuário escolher um número menor.
                } else if (palpite < numeroSecreto) {
                    System.out.println("O número secreto é MAIOR!"); // SE o palpite for menor do que o número secreto, então a mensagem vai orientar ao usuário escolher um número maior.
                } else { // SENÃO, se o palpite não for maior e nem menor do que o número secreto, então é o número secreto
                    System.out.println("Parabéns! Você acertou o número secreto com " + tentativas + " tentativas!"); // mostra quantas tentativas o usuário levou até acertar
                    acertou = true;
                }
            }

            if (!acertou) { // "SE NÃO acertou" (o ! inverte)
                System.out.println("Você perdeu! O número secreto era: " + numeroSecreto); // mostra a mensagem de derrota
            }

            System.out.println();

            System.out.println("Quer tentar de novo?(s/n)"); // Mostra a pergunta
            entrada.nextLine(); // consome o enter que sobrou do nextInt()
            jogarNovamente = entrada.next().charAt(0); // lê o primeiro caractere digitado
        } while (jogarNovamente == 'S' || jogarNovamente == 's'); // se o usuário digitar 'S' ou 's', o loop repete. Caso digitar qualquer outra coisa, ele se encerra.

        System.out.println("Fim de jogo. Obrigada por jogar!"); // mensagem final
        entrada.close(); // fecha o scanner
    }
}
